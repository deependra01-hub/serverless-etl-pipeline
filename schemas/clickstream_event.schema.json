{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ClickstreamEvent",
  "type": "object",
  "required": [
    "event_id",
    "event_time",
    "event_type",
    "session_id",
    "user_id",
    "page_url",
    "channel",
    "device_type",
    "country_code",
    "schema_version"
  ],
  "properties": {
    "event_id": { "type": "string", "minLength": 10 },
    "event_time": { "type": "string", "format": "date-time" },
    "event_type": {
      "type": "string",
      "enum": ["page_view", "product_view", "add_to_cart", "checkout_started", "search", "ad_click"]
    },
    "session_id": { "type": "string", "minLength": 8 },
    "user_id": { "type": "string", "minLength": 8 },
    "anonymous_id": { "type": ["string", "null"] },
    "page_url": { "type": "string" },
    "product_id": { "type": ["string", "null"] },
    "category": { "type": ["string", "null"] },
    "campaign_id": { "type": ["string", "null"] },
    "channel": {
      "type": "string",
      "enum": ["organic", "paid_search", "social", "email", "affiliate", "direct"]
    },
    "device_type": {
      "type": "string",
      "enum": ["mobile", "desktop", "tablet"]
    },
    "browser": { "type": ["string", "null"] },
    "country_code": { "type": "string", "minLength": 2, "maxLength": 2 },
    "referrer": { "type": ["string", "null"] },
    "ip_hash": { "type": ["string", "null"] },
    "schema_version": { "type": "integer", "minimum": 1 }
  }
}

